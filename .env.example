# Leasora Monorepo - Environment Configuration
# Copy this file to .env and fill in your values.
# .env is listed in .gitignore and should never be committed.
# All variables prefixed with LEASORA_ or referenced directly below are supported.

################################################################################
# LLM Configuration
################################################################################

# Groq API Key — Optional at startup; required for live answers and comparisons.
# Leave empty to use ingestion and retrieval-only features locally.
# Get a free API key (no credit card required) at: https://console.groq.com
LEASORA_GROQ_API_KEY=

# Groq LLM Model — Main model for lease analysis
# Examples: llama-3.3-70b-versatile, llama-2-70b-chat
LEASORA_GROQ_MODEL=llama-3.3-70b-versatile

# LLM Timeout (seconds) — Maximum wait time for LLM responses
LEASORA_LLM_TIMEOUT_SECONDS=60

################################################################################
# Retrieval and Reranking
################################################################################

# Rerank Enabled — Master switch for the cross-encoder reranking stage.
# Default OFF. See docs/EVALUATION_REPORT.md: reranking measurably improves
# refusal accuracy and MRR, but the shipped checkpoint is MS MARCO web-search
# data, not legal text, so it stays opt-in until domain-tuned.
LEASORA_RERANK_ENABLED=false

# Reranker Model — sentence-transformers CrossEncoder checkpoint used when
# LEASORA_RERANK_ENABLED=true. Swappable for a domain-tuned checkpoint
# without code changes.
LEASORA_RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# Rerank Candidate Pool — how many dense-retrieval candidates are pulled
# before the cross-encoder re-scores and trims down to LEASORA_RETRIEVAL_TOP_K.
LEASORA_RERANK_TOP_N=20

# Hybrid Retrieval — fuses dense (embedding) retrieval with a per-lease BM25
# lexical index. REQUIRES LEASORA_RERANK_ENABLED=true (Settings refuses to
# start otherwise): hybrid alone regressed refusal accuracy from 0.913 to
# 0.826 in eval (see docs/EVALUATION_REPORT.md); reranking recovers it.
LEASORA_HYBRID_ENABLED=false

# Hybrid Fusion Weight — 0.0 = BM25 only, 1.0 = dense only, 0.5 = even split.
LEASORA_HYBRID_ALPHA=0.5

# Embedding Model — sentence-transformers bi-encoder used for dense retrieval.
LEASORA_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Retrieval Top-K — number of chunks returned to the LLM as context.
LEASORA_RETRIEVAL_TOP_K=5

# Refusal Threshold — retrieval distance above which the API refuses instead
# of calling the LLM (0.0–1.0; lower = closer/more relevant). Deterministic
# refusal gate, evaluated before any LLM call.
LEASORA_REFUSAL_THRESHOLD=0.55

# Answer Guard — post-generation LLM-as-judge check that the answer's claims
# are grounded in the retrieved context; downgrades ungrounded answers to a
# refusal. Adds one extra LLM call per question, so it defaults off.
LEASORA_ANSWER_GUARD_ENABLED=false

################################################################################
# Observability and Tracing (Langfuse)
################################################################################

# Langfuse Configuration — PRIVACY BY DEFAULT.
# Lease text is PII-heavy (names, SSNs, DOBs, signatures). The Langfuse
# wrapper refuses to initialize the client unless ALL FOUR of the
# following are set together:
#   1. LEASORA_LANGFUSE_ENABLED=true (master kill-switch, default OFF)
#   2. LEASORA_LANGFUSE_HOST=<non-empty URL>
#   3. LEASORA_LANGFUSE_PUBLIC_KEY=<key>
#   4. LEASORA_LANGFUSE_SECRET_KEY=<key>
# An empty host will NOT default to https://cloud.langfuse.com — the
# wrapper logs a warning and stays disabled to avoid sending lease
# text to a third-party SaaS without explicit operator opt-in.

# --- HOSTED LANGFUSE (cloud.langfuse.com) ---
# Get credentials from https://cloud.langfuse.com after creating a project.
# LEASORA_LANGFUSE_ENABLED=true
# LEASORA_LANGFUSE_PUBLIC_KEY=pk-lf-your_public_key
# LEASORA_LANGFUSE_SECRET_KEY=sk-lf-your_secret_key
# LEASORA_LANGFUSE_HOST=https://cloud.langfuse.com

# --- SELF-HOSTED LANGFUSE (via services/compose/docker-compose.yml) ---
# `langfuse` + `langfuse-db` (Postgres) run as containers in this repo's
# compose stack. On first `docker-compose up`, visit http://localhost:3001,
# create an account + project through the UI, then copy the generated
# public/secret keys here (there's no way to pre-seed them; Langfuse issues
# them per-project after signup).
# LEASORA_LANGFUSE_ENABLED=true
# LEASORA_LANGFUSE_PUBLIC_KEY=pk-lf-your_public_key
# LEASORA_LANGFUSE_SECRET_KEY=sk-lf-your_secret_key
# LEASORA_LANGFUSE_HOST=http://localhost:3001
# Use http://langfuse:3000 instead when the API also runs inside Compose with
# the observability profile enabled.
#
# Also set these three before running docker-compose (use generated secrets
# outside local development):
# LANGFUSE_NEXTAUTH_SECRET=some-random-string
# LANGFUSE_SALT=another-random-string
# LANGFUSE_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Langfuse is OFF by default, so no traces leave the API unless all
# LEASORA_LANGFUSE_* settings above are explicitly configured.

################################################################################
# Storage Configuration
################################################################################

# User-Uploaded PDFs directory
# Stores lease PDFs submitted via /upload endpoint. The route saves each
# upload as <upload_dir>/<lease_id>.pdf (server-generated filename, not the
# client's original filename) before handing it to the ingest pipeline.
LEASORA_UPLOAD_DIR=data/uploads

# Lease/Comparison Metadata Stores
# JSON-file-backed stores (single-process; see ADRs for the scaling story).
LEASORA_LEASE_STORE_PATH=data/leases.json
LEASORA_COMPARISON_STORE_PATH=data/comparisons.json
LEASORA_COMPARISON_STORE_MAX_RECORDS=500

# Uploaded lease retention — the API sweeps at startup and every 24 hours,
# cascade-deleting source PDFs and all derived artifacts older than this.
# Must be a positive integer. Default: 30 days.
LEASORA_UPLOAD_RETENTION_DAYS=30

# Comparison Feature Tuning — bounds on the multi-lease compare fan-out.
LEASORA_COMPARE_MAX_CHUNKS_PER_LEASE=20
LEASORA_COMPARE_MAX_CONCURRENT_LLM_CALLS=5
LEASORA_COMPARE_PER_CLAUSE_TIMEOUT_SECONDS=30.0
LEASORA_COMPARE_OVERALL_TIMEOUT_BUFFER_SECONDS=5.0

################################################################################
# Cache Configuration
################################################################################

# Enable Caching — master switch for both the exact-match query cache and
# (if also enabled below) the semantic cache. Both are scoped per lease_id
# and invalidated on re-ingest.
LEASORA_CACHE_ENABLED=true

# Semantic Cache — near-duplicate question matching on top of the exact-match
# cache. Off by default; costs an embedding comparison per cache lookup.
LEASORA_SEMANTIC_CACHE_ENABLED=false

# Semantic Cache Similarity Threshold
# Cosine similarity threshold for cache hits (0.0–1.0)
# Higher = stricter matching (fewer false positives, fewer hits)
LEASORA_CACHE_THRESHOLD=0.92

################################################################################
# Rate Limiting
################################################################################

# Rate Limiting — per-client request throttling, primarily for cost control
# (not abuse protection; see the X-Forwarded-For trust model in ADR-006).
LEASORA_RATE_LIMIT_ENABLED=true
LEASORA_RATE_LIMIT_PER_MINUTE=30

################################################################################
# Logging Configuration
################################################################################

# Access-log HMAC Salt — used to hash user queries in access logs so raw
# question text never hits disk. Leave unset for local dev (falls back to a
# hard-coded dev salt); set a real secret in any shared environment.
LEASORA_LOG_HASH_SALT=

################################################################################
# Security and Defense
################################################################################

# PII redaction is always enabled at storage, logging, tracing, and API trust
# boundaries; it is intentionally not operator-configurable.

# Enable Prompt-Injection Defense
# If true, retrieved chunks are sanitized before LLM context.
# The sanitization regex list catches common injection phrases
# ("ignore the above", etc.); set to false only for known-clean corpora.
LEASORA_PROMPT_INJECTION_DEFENSE_ENABLED=true

# Max Upload Size (bytes) — rejects larger uploads before they're parsed.
# Must be between 1 MiB and 1 GiB. Default: 50 MiB.
LEASORA_MAX_UPLOAD_SIZE_BYTES=52428800

################################################################################
# Evaluation
################################################################################
# The eval harness (retrieval metrics + LLM-as-judge answer quality) is run
# via the `leasora-eval` CLI, not environment variables:
#   cd apps/api && leasora-eval --compare-hybrid   # retrieval only, no LLM calls
#   cd apps/api && leasora-eval --full              # + LLM-as-judge (needs Groq key)
# See docs/EVALUATION_REPORT.md for the golden dataset and measured results.

################################################################################
# API Configuration
################################################################################

# CORS Allowed Origins — comma-separated list or JSON array.
LEASORA_CORS_ORIGINS=http://localhost:3000

# Request ID Echo — the request-correlation middleware always generates a
# per-request ID for log correlation; this only controls whether it's also
# echoed back as the X-Request-ID response header.
LEASORA_REQUEST_ID_ENABLED=true

################################################################################
# Frontend Configuration
################################################################################

# Frontend API Base URL (used by Next.js client)
# In development: http://localhost:8000
# In staging/production: https://api.leasora.example.com
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Frontend URL (used for CORS, redirects, etc.)
NEXT_PUBLIC_FRONTEND_URL=http://localhost:3000

################################################################################
# Deployment Checklist
################################################################################

# Before deploying to production:
# ✓ Configure LEASORA_LANGFUSE_* credentials if observability is enabled
# ✓ For self-hosted Langfuse, set LANGFUSE_NEXTAUTH_SECRET, LANGFUSE_SALT,
#   and LANGFUSE_ENCRYPTION_KEY as described in the setup block above
# ✓ Ensure LEASORA_GROQ_API_KEY is set via secure secret manager
# ✓ Set LEASORA_LOG_HASH_SALT to a deployment-specific secret
# ✓ Verify NEXT_PUBLIC_API_BASE_URL points to production API endpoint
